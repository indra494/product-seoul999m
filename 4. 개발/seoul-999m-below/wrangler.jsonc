{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seoul-999m-below",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-room-hub",
      "new_sqlite_classes": ["RoomHub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
