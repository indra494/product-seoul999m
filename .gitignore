# Secrets and machine-local configuration
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem

# Dependencies and package-manager caches
**/node_modules/
**/.tools/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/versions/

# Generated builds, test output and deployment caches
**/.next/
**/.vinext/
**/dist/
**/out/
**/coverage/
**/.wrangler/
**/.vercel/
**/outputs/
**/work/
**/playwright-report/
**/test-results/
**/*.tsbuildinfo

# Debug and operating-system noise
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/.DS_Store
**/Thumbs.db
**/*.tmp
**/*.temp

# Local Codex working memory; keep project instructions and templates tracked
99. codex/context/
99. codex/logs/
.codex/
.agents/
